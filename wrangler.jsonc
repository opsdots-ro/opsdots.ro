{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opsdots-ro",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,

  // Domeniul (opsdots.ro și www) — Cloudflare creează automat DNS-ul și certificatul
  "routes": [
    { "pattern": "opsdots.ro", "custom_domain": true },
    { "pattern": "www.opsdots.ro", "custom_domain": true }
  ],

  // Site-ul static
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Fiecare cerere trece prin Worker → apare în loguri
    "run_worker_first": true
  },

  // Formular de contact (Resend). Secretele NU se pun aici, ci în Dashboard:
  //   RESEND_API_KEY, CONTACT_TO, TURNSTILE_SECRET (opțional) → Settings → Variables and Secrets → type "Secret"
  "vars": {
    "CONTACT_FROM": "OpsDots Website <website@opsdots.ro>",
    "TURNSTILE_SITE_KEY": ""          // opțional: Site Key din Cloudflare Turnstile (e publică)
  },

  // Max. 5 trimiteri de formular pe minut per IP
  "ratelimits": [
    { "name": "CONTACT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  // Observability: Workers Logs + Traces (Dashboard → Workers & Pages → opsdots-ro → Observability)
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,          // 100% din cereri logate (free: 200k evenimente/zi, 3 zile retenție)
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1       // 10% din cereri trasate (spans se contorizează ca evenimente de log)
    }
  }
}
